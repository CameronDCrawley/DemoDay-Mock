<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Volunteer Portal</title>
</head>
<body>
  <h1> Volunteer</h1>
  <form action="/volunteerInfo" method="post">
    <ul>
<li>
    <label for="addName">Volunteer Name:</label>
    <input type="text" id="addName" name="volunteerName" placeholder="Name Here" required>
    </li>

       <li>
    <label for="addTitle">Job Title:</label>
    <input type="text" id="addTitle" name="title" placeholder="What do you do ?" >
    </li>
        

    <li>

    <label for="addInterests">Interests</label>
    <input type="text" id="addInterests" name="interests" placeholder="Hobbies" >
    </li>

    <li>

    <label for="addSkills">Skills:</label>
    <input type="text" id="addSkills" name="skills" placeholder="skills" >
    </li>
<li>
    <li>
    <label for="addDescription">Description:</label>
    <input type="text" id="addDescription" name="description" placeholder="ANYTHING YOU WOULD LIKE US TO KNOW" required>
    
    </li>

</body>
</html>